@model TMS_SharedLibrary.Models.Toy
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Title"];
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card shadow-sm rounded-3 border-0">
                <div class="card-header bg-danger text-white rounded-top-3">
                    <h4 class="mb-0">@Localizer["DeleteToy"]</h4>
                </div>

                <div class="card-body">

                    <p class="text-muted">
                        @Localizer["DeleteConfirmation"]
                    </p>

                    <div class="mb-3">
                        <strong>@Localizer["Name"]</strong> @Model.Name
                    </div>
                    <div class="mb-3">
                        <strong>@Localizer["Description"]</strong> @Model.Description
                    </div>
                    <div class="mb-3">
                        <strong>@Localizer["Category"]</strong> @Model.Category
                    </div>
                    <div class="mb-3">
                        <strong>@Localizer["Material"]</strong> @Model.Material
                    </div>
                    <div class="mb-3">
                        <strong>@Localizer["Location"]</strong> @Model.LocationCode
                    </div>
                    <div class="mb-3">
                        <strong>@Localizer["Available"]</strong>
                        <span class="badge @(Model.IsAvailable ? "bg-success" : "bg-danger")">
                            @(Model.IsAvailable ? Localizer["AvailableStatus"] : Localizer["Borrowed"])
                        </span>
                    </div>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="ToyId" />

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-danger px-4">@Localizer["Delete"]</button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">@Localizer["Cancel"]</a>
                        </div>
                    </form>

                </div>
            </div>

        </div>
    </div>
</div>
