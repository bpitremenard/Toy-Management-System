@model IEnumerable<TMS_SharedLibrary.Models.ToyViewModel>
@using System.IO

@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["Title"];
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5">@Localizer["Header"]</h1>
        <div>
            <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#filterModal">
                <i class="bi bi-funnel"></i> @Localizer["Filter"]
            </button>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null) {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>@Localizer["Success"]!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null) {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>@Localizer["Error"]!</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <!-- Search Bar -->
    <div class="search-container">
        <form asp-action="Index" method="get" class="search-form">
            <div class="search-input-group">
                <i class="bi bi-search search-icon"></i>
                <input type="text"
                       name="searchQuery"
                       class="search-input"
                       placeholder="@Localizer["SearchPlaceholder"]"
                       value="@ViewBag.SearchQuery"
                       autocomplete="off">
            </div>
            <input type="hidden" name="categories" value="@ViewBag.SelectedCategory" />
            <input type="hidden" name="materials" value="@ViewBag.SelectedMaterial" />
            <button type="submit" class="search-btn" id="student-search-btn">
                <i class="bi bi-search"></i> Search
            </button>
            @if (!string.IsNullOrEmpty(ViewBag.SearchQuery as string) ||
                        !string.IsNullOrEmpty(ViewBag.SelectedCategory as string) ||
                        !string.IsNullOrEmpty(ViewBag.SelectedMaterial as string)) {
                <a asp-action="Index" class="clear-btn">
                    <i class="bi bi-x-circle"></i> @Localizer["ClearButton"]
                </a>
            }
        </form>
    </div>
</div>

<div class="row g-4">
    @if (!Model.Any()) {
        <div class="col-12">
            <div class="alert alert-info">@Localizer["NoToysFound"]</div>
        </div>
    }
    @foreach (var vm in Model) {
        var item = vm.Toy;
        var itemLoanData = vm.ToyLoan;
        bool borrowedByCurrentStudent = vm.BorrowedByCurrentStudent;
        int? daysLeft = vm.DaysLeft;
        bool borrowedByAnotherStudent = !borrowedByCurrentStudent && !item.IsAvailable;

        string cardClass =
        borrowedByCurrentStudent ? "toy-card h-100 reserved" :
        borrowedByAnotherStudent ? "toy-card h-100 disabled-card" :
        "toy-card h-100";

        <div class="col-12 col-md-6 col-lg-4">
            <div class="@cardClass d-flex flex-column h-100">
                <div class="toy-img-wrapper">
                    @if (!string.IsNullOrEmpty(item.ImagePath)) {
                       var fileName = System.IO.Path.GetFileName(item.ImagePath ?? "");
                       var imgUrl = string.IsNullOrWhiteSpace(fileName) ? "" : Url.Content("~/toy-images/" + fileName);

                       <img src="@Url.Content(imgUrl)" class="toy-img" alt="@item.Name" />

                    } else {
                        <div class="toy-img no-img">@Localizer["NoImage"]</div>
                    }
                </div>

                <div class="card-body">
                    <h5 class="text-muted mb-2">@item.Name</h5>
                    @if (!string.IsNullOrWhiteSpace(item.Description)) {
                        <p class="small mb-2">@item.Description</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(item.AdditionalInformation)) {
                        <p class="small mb-2"><strong>Additional Information:</strong> @item.AdditionalInformation</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(item.Category)) {
                        <div class="mb-1"><strong>@Localizer["Category"]</strong> @item.Category</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(item.Material)) {
                        <div class="mb-1"><strong>@Localizer["Material"]</strong> @item.Material</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(item.LocationCode)) {
                        <div class="mb-1"><strong>@Localizer["Location"]</strong> @item.LocationCode</div>
                    }
                    @if (borrowedByCurrentStudent && itemLoanData != null && daysLeft != null)
                    {
                        <div class="mb-1">
                            <strong>@Localizer["DueDate"]</strong> @itemLoanData.DueDate
                            (
                            @if (daysLeft == 0)
                            {
                                @Localizer["DueToday"]
                            }
                            else if (daysLeft > 0)
                            {
                                @string.Format(Localizer["DueInDays"].Value, daysLeft)
                            }
                            else
                            {
                                <span class="text-danger">
                                    @string.Format(Localizer["OverdueByDays"].Value, Math.Abs(daysLeft.Value))
                                </span>
                            }
                            )
                        </div>
                    }
                </div>

                <div class="card-footer bg-white border-0 mt-auto pb-3">
                    <div class="toy-btn-row">
                        @if (borrowedByCurrentStudent) {
                            <a asp-action="Return" asp-route-id="@item.ToyId" class="btn btn-sm btn-light border">@Localizer["Return"]</a>
                        } else if (borrowedByAnotherStudent) {
                            <button class="btn btn-sm btn-secondary border" disabled>@Localizer["Reserved"]</button>
                        } else {
                            <a asp-action="Borrow" asp-route-id="@item.ToyId" class="btn btn-sm btn-light border">@Localizer["Reserve"]</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<div class="modal fade" id="filterModal" tabindex="-1" aria-labelledby="filterModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="filterModalLabel">@Localizer["FilterToys"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Index" method="get">
                <div class="modal-body">
                    <div class="mb-4">
                        <label class="form-label fw-bold">@Localizer["DevelopmentGoal"]</label>
                        <select class="form-select" name="categories" id="developmentGoalFilter">
                            <option value="">@Localizer["AllCategories"]</option>
                            <option value="Cognitive" selected='@(ViewBag.SelectedCategory == "Cognitive")'>@Localizer["CategoryCognitive"]</option>
                            <option value="Social and Emotional" selected='@(ViewBag.SelectedCategory == "Social and Emotional")'>@Localizer["CategorySocialEmotional"]</option>
                            <option value="Sensory" selected='@(ViewBag.SelectedCategory == "Sensory")'>@Localizer["CategorySensory"]</option>
                            <option value="Physical" selected='@(ViewBag.SelectedCategory == "Physical")'>@Localizer["CategoryPhysical"]</option>
                        </select>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-bold">@Localizer["Material"]</label>
                        <select class="form-select" name="materials" id="materialFilter">
                            <option value="">@Localizer["AllMaterials"]</option>
                            <option value="Wood" selected='@(ViewBag.SelectedMaterial == "Wood")'>@Localizer["MaterialWood"]</option>
                            <option value="Plastic" selected='@(ViewBag.SelectedMaterial == "Plastic")'>@Localizer["MaterialPlastic"]</option>
                            <option value="Plush" selected='@(ViewBag.SelectedMaterial == "Plush")'>@Localizer["MaterialPlush"]</option>
                            <option value="Metal" selected='@(ViewBag.SelectedMaterial == "Metal")'>@Localizer["MaterialMetal"]</option>
                            <option value="Rubber" selected='@(ViewBag.SelectedMaterial == "Rubber")'>@Localizer["MaterialRubber"]</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">@Localizer["ApplyFilters"]</button>
                    <a asp-action="Index" class="btn btn-outline-secondary me-2">@Localizer["ClearFilters"]</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        setTimeout(function() { $('.alert').fadeOut('slow'); }, 5000);
    </script>
}
